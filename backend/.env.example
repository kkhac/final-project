DATABASE_URL=postgresql://postgres:password@localhost:5432/llm_testing
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
SECRET_KEY=change-me-in-production
ENVIRONMENT=development

# Auth — JWT
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# Auth — Google OAuth (optional; required for "Sign in with Google")
